<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATpromo — Campanha Oficial Black Friday (Neo-Brutalismo Comercial)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Tipografia Comercial Pesada: Anton (Impacto Monumental), Space Grotesk (Tech/Números), Plus Jakarta Sans (DNA ATpromo), JetBrains Mono (Specs/Tech) -->
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@700;800&family=Plus+Jakarta+Sans:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Space+Grotesk:wght@700&family=Syne:wght@800&display=swap" rel="stylesheet">
    <style>
        :root {
            --font-main: 'Plus Jakarta Sans', sans-serif;
            --font-impact: 'Anton', sans-serif;
            --font-tech: 'Space Grotesk', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --bf-gold: #FFD000;
            --bf-yellow: #FFE600;
            --bf-cyber: #FCEE0A;
            --at-orange: #FF5A1F;
            --bf-red: #FF2E00;
        }

        body {
            font-family: var(--font-main);
            background-color: #09090B;
            color: #F4F4F5;
        }

        .font-impact {
            font-family: var(--font-impact);
            letter-spacing: 0.02em;
        }
        .font-tech {
            font-family: var(--font-tech);
        }
        .font-mono-tech {
            font-family: var(--font-mono);
        }

        /* Neo-Brutalist Core Borders & Hard Shadows */
        .nb-border {
            border: 3.5px solid #000000;
        }
        .nb-border-thick {
            border: 4px solid #000000;
        }
        .nb-border-thin {
            border: 2.5px solid #000000;
        }
        .nb-border-gold {
            border: 3.5px solid #FFD000;
        }

        /* High-Contrast Commercial Price Strokes */
        .price-stroke-black {
            text-shadow: 4px 4px 0px #000000;
            -webkit-text-stroke: 2px #000000;
        }
        .price-stroke-gold {
            text-shadow: 4px 4px 0px #FFD000;
            -webkit-text-stroke: 2px #000000;
        }
        .price-stroke-red {
            text-shadow: 4px 4px 0px #FF2E00;
            -webkit-text-stroke: 2px #000000;
        }

        /* Proporção exata Instagram 4:5 (400x500px = escala exata de 1080x1350px) */
        .insta-canvas {
            width: 400px;
            height: 500px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            user-select: none;
            flex-shrink: 0;
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Padrões de Fundo Black Friday */
        .bg-grid-premium {
            background-color: #0A0A0C;
            background-image: 
                linear-gradient(to right, rgba(255, 208, 0, 0.07) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 208, 0, 0.07) 1px, transparent 1px);
            background-size: 24px 24px;
        }

        .bg-hazard-stripes {
            background: repeating-linear-gradient(
                -45deg,
                #FFE600,
                #FFE600 12px,
                #000000 12px,
                #000000 24px
            );
        }

        .bg-tech-matrix {
            background-color: #0B0D11;
            background-image: radial-gradient(rgba(252, 238, 10, 0.16) 1px, transparent 1px);
            background-size: 16px 16px;
        }

        /* Recortes Geométricos Neo-Brutalistas */
        .clip-chamfer {
            clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 14px 100%, 0 calc(100% - 14px));
        }

        .ticket-coupon {
            clip-path: polygon(
                0% 0%, 100% 0%, 
                100% 36%, 96% 44%, 96% 56%, 100% 64%, 
                100% 100%, 0% 100%, 
                0% 64%, 4% 56%, 4% 44%, 0% 36%
            );
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #121215;
        }
        ::-webkit-scrollbar-thumb {
            background: #FFD000;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-[#FFD000] selection:text-black">

    <!-- Top Studio Header -->
    <header class="bg-zinc-950/95 backdrop-blur border-b-2 border-zinc-800 sticky top-0 z-40 px-4 py-3 shadow-2xl">
        <div class="max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-3">
            <!-- Brand Identity -->
            <div class="flex items-center gap-3">
                <div class="bg-[#FFD000] text-black font-black px-3 py-1.5 rounded-lg border-2 border-black shadow-[3px_3px_0px_#FF5A1F] text-sm tracking-tight flex items-center gap-1.5">
                    <span class="text-[#FF5A1F] underline decoration-2">AT</span><span>promo</span>
                    <span class="bg-black text-[#FFD000] px-1.5 py-0.5 rounded text-[10px] font-mono-tech uppercase">BLACK FRIDAY</span>
                </div>
                <div>
                    <h1 class="text-sm sm:text-base font-extrabold text-white leading-tight flex items-center gap-2">
                        <span>Gerador de Campanhas Black Friday (4:5 • 1080×1350)</span>
                    </h1>
                    <p class="text-xs text-zinc-400">1. Black Friday Premium • 2. Black Friday Explosiva • 3. Black Friday Tech</p>
