                    👁️ Lado a Lado (3 Propostas)
                </button>
                <button onclick="setViewMode('single')" id="btnViewSingle" class="px-3 py-1.5 rounded-lg text-xs font-extrabold text-zinc-300 hover:text-white transition">
                    🔍 Visualização Individual
                </button>
                <button onclick="openCodeModal()" class="px-3 py-1.5 rounded-lg text-xs font-extrabold bg-zinc-800 text-[#FFD000] hover:bg-zinc-700 border border-zinc-700 transition">
                    💻 Exportar HTML/CSS
                </button>
                <button onclick="downloadHighResPNG()" id="btnDownloadPNG" class="px-3 py-1.5 rounded-lg text-xs font-extrabold bg-[#FF5A1F] text-white hover:bg-[#e04812] border border-black shadow-[2px_2px_0px_#000] transition">
                    ⬇️ Baixar PNG (1080×1350)
                </button>
            </div>
        </div>
    </header>

    <!-- Live Editable Control Bar -->
    <section class="bg-zinc-900/90 border-b border-zinc-800 px-4 py-3">
        <div class="max-w-[1440px] mx-auto grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-9 gap-2.5 items-end">
            
            <!-- 1. Campanha -->
            <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#FFD000] mb-1">Campanha</label>
                <input type="text" id="inputCampaign" value="BLACK FRIDAY" oninput="updateStudio()" 
                    class="w-full bg-zinc-950 border border-amber-400/50 rounded-lg px-2.5 py-1.5 text-xs font-black text-[#FFD000] focus:border-[#FFD000] focus:outline-none">
            </div>

            <!-- 2. Gatilho -->
            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">Gatilho Comercial</label>
                <input type="text" id="inputTrigger" value="Vazou o preço:" oninput="updateStudio()" 
                    class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs font-bold text-white focus:border-[#FFD000] focus:outline-none">
            </div>

            <!-- 3. Produto -->
            <div class="col-span-2 sm:col-span-1">
                <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">Produto</label>
                <input type="text" id="inputProduct" value="ELG Power Bank 20000mAh" oninput="updateStudio()" 
                    class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs font-bold text-white focus:border-[#FFD000] focus:outline-none">
            </div>

            <!-- 4. Especificações -->
            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">Especificações</label>
                <input type="text" id="inputSpec" value="ELG PB200BK • 22,5W" oninput="updateStudio()" 
                    class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-2.5 py-1.5 text-xs font-bold text-white focus:border-[#FFD000] focus:outline-none">
            </div>

            <!-- 5. Loja -->
            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">Loja Oficial</label>
                <select id="inputStore" onchange="updateStudio()" 
                    class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-2 py-1.5 text-xs font-bold text-white focus:border-[#FFD000] focus:outline-none">
                    <option value="🛒 AMAZON">🛒 AMAZON</option>
                    <option value="🤝 MERCADO LIVRE">🤝 MERCADO LIVRE</option>
                    <option value="🧡 SHOPEE">🧡 SHOPEE</option>
                    <option value="⚡ KABUM!">⚡ KABUM!</option>
                    <option value="🔥 ALIEXPRESS">🔥 ALIEXPRESS</option>
                    <option value="💙 MAGALU">💙 MAGALU</option>
                </select>
            </div>

            <!-- 6. Preço Anterior & Atual -->
            <div class="flex gap-1.5 col-span-2 sm:col-span-1">
                <div class="w-1/2">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">De (R$)</label>
                    <input type="text" id="inputOldPrice" value="149,90" oninput="updateStudio()" 
                        class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-2 py-1.5 text-xs font-bold text-zinc-400 focus:border-[#FFD000] focus:outline-none">
                </div>
                <div class="w-1/2">
                    <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#FFD000] mb-1">Por (R$)</label>
                    <input type="text" id="inputNewPrice" value="116,75" oninput="updateStudio()" 
                        class="w-full bg-zinc-950 border border-amber-400/60 rounded-lg px-2 py-1.5 text-xs font-black text-[#FFD000] focus:border-[#FFD000] focus:outline-none">
                </div>
            </div>

            <!-- 7. Desconto -->
            <div>
                <label class="block text-[10px] font-extrabold uppercase tracking-wider text-[#FF5A1F] mb-1">Selo Desconto</label>
                <input type="text" id="inputDiscount" value="22% OFF" oninput="updateStudio()" 
                    class="w-full bg-zinc-950 border border-orange-500/50 rounded-lg px-2.5 py-1.5 text-xs font-black text-[#FF5A1F] focus:border-[#FFD000] focus:outline-none">
            </div>

            <!-- 8. Condição / Garantia -->
            <div>
                <label class="block text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">Condição PIX / Topo</label>
                <select id="inputCondition" onchange="updateStudio()" 
                    class="w-full bg-zinc-950 border border-zinc-700 rounded-lg px-2 py-1.5 text-xs font-bold text-white focus:border-[#FFD000] focus:outline-none">
                    <option value="À vista no PIX">À vista no PIX</option>
                    <option value="No PIX com Cupom">No PIX com Cupom</option>
                    <option value="Em até 10x sem juros">Em até 10x s/ juros</option>
                    <option value="Menor Preço Histórico">Menor Preço Histórico</option>
                </select>
            </div>

            <!-- 9. Uploads de Imagem do Produto e Logo -->
            <div class="flex gap-1.5">
                <label class="flex-1 cursor-pointer bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-600 rounded-lg px-2 py-1.5 text-[11px] font-extrabold text-center transition truncate" title="Carregar foto PNG/JPG do produto">
                    📷 Produto
                    <input type="file" accept="image/*" class="hidden" onchange="handleImageUpload(event, 'product')">
                </label>
                <label class="cursor-pointer bg-zinc-800 hover:bg-zinc-700 text-white border border-zinc-600 rounded-lg px-2.5 py-1.5 text-[11px] font-extrabold text-center transition" title="Carregar logo ATpromo">
                    🧑 Logo
                    <input type="file" accept="image/*" class="hidden" onchange="handleImageUpload(event, 'logo')">
                </label>
            </div>

        </div>
    </section>

    <!-- Single View Selector Tabs -->
    <div id="singleModeSelector" class="hidden justify-center gap-3 pt-5 px-4 flex-wrap">
        <button onclick="selectVariation(0)" id="tabVar0" class="px-4 py-2 rounded-xl font-extrabold text-xs border-2 border-black shadow-[4px_4px_0px_#FFD000] bg-zinc-900 text-[#FFD000] transition">
            1. BLACK FRIDAY PREMIUM (Ouro & Contraste)
        </button>
        <button onclick="selectVariation(1)" id="tabVar1" class="px-4 py-2 rounded-xl font-extrabold text-xs border-2 border-black shadow-[4px_4px_0px_#FF2E00] bg-[#FFE600] text-black transition">
            2. BLACK FRIDAY EXPLOSIVA (Liquidação & Impacto)
        </button>
        <button onclick="selectVariation(2)" id="tabVar2" class="px-4 py-2 rounded-xl font-extrabold text-xs border-2 border-black shadow-[4px_4px_0px_#FF5A1F] bg-zinc-900 text-[#FCEE0A] transition">
            3. BLACK FRIDAY TECH (Hardware & Eletrônicos)
        </button>
    </div>

    <!-- Main Studio Showcase -->
    <main class="flex-1 max-w-[1440px] w-full mx-auto px-4 py-6 flex items-start justify-center">
        <div id="studioContainer" class="grid grid-cols-1 lg:grid-cols-3 gap-10 justify-items-center items-start w-full">
            <!-- Renderizado dinamicamente via JS -->
        </div>
    </main>

    <!-- Modal de Exportação de Código HTML/CSS -->
    <div id="codeModal" class="fixed inset-0 bg-black/85 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
        <div class="bg-zinc-900 border-2 border-[#FFD000] rounded-2xl max-w-4xl w-full p-6 shadow-2xl max-h-[88vh] flex flex-col">
            <div class="flex items-center justify-between pb-4 border-b border-zinc-800">
                <div>
                    <h2 class="text-lg font-extrabold text-white">💻 Exportar Código HTML + CSS da Arte</h2>
                    <p class="text-xs text-zinc-400">Selecione a proposta abaixo para copiar o código completo e auto-contido</p>
                </div>
                <button onclick="closeCodeModal()" class="text-zinc-400 hover:text-white font-bold text-2xl px-2">&times;</button>
            </div>

            <div class="flex flex-wrap gap-2 my-3">
                <button onclick="showCodeFor(0)" id="codeBtn0" class="px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-[#FFD000] text-black">1. Black Friday Premium</button>
                <button onclick="showCodeFor(1)" id="codeBtn1" class="px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-zinc-800 text-zinc-300">2. Black Friday Explosiva</button>
                <button onclick="showCodeFor(2)" id="codeBtn2" class="px-3.5 py-1.5 rounded-lg text-xs font-extrabold bg-zinc-800 text-zinc-300">3. Black Friday Tech</button>
            </div>

            <div class="my-2 overflow-y-auto flex-1">
                <pre id="codeExportArea" class="bg-zinc-950 p-4 rounded-xl border border-zinc-800 text-[11px] text-[#FFD000] font-mono overflow-x-auto leading-relaxed whitespace-pre-wrap"></pre>
            </div>

            <div class="flex justify-end gap-3 pt-3 border-t border-zinc-800">
                <button onclick="copyExportedCode()" id="btnCopyConfirm" class="bg-[#FFD000] hover:bg-[#e6bc00] text-black font-black text-xs px-5 py-2.5 rounded-xl border-2 border-black shadow-[3px_3px_0px_#FF5A1F] transition">
                    📋 Copiar Código HTML/CSS
                </button>
            </div>
        </div>
    </div>

    <script>
        let customProductImg = null;
        let customLogoImg = null;
        let viewMode = 'grid';
        let focusedIndex = 0;
        let selectedCodeIndex = 0;

        // Ilustração Vetorial Fiel do Produto (ELG Power Bank 20000mAh) sem interferências visuais
        function getProductVisualHTML() {
            if (customProductImg) {
                return `<img src="${customProductImg}" alt="Produto em Oferta" class="max-h-[145px] max-w-[240px] object-contain mx-auto drop-shadow-sm" />`;
            }
            return `
            <svg viewBox="0 0 200 205" class="w-[138px] h-[138px] mx-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g transform="rotate(12 100 102)">
                    <!-- Profundidade Lateral -->
                    <rect x="64" y="14" width="80" height="170" rx="12" fill="#1E2028" stroke="#000000" stroke-width="3.5"/>
                    <!-- Corpo Principal Grafite -->
                    <rect x="52" y="18" width="80" height="170" rx="10" fill="#363946" stroke="#000000" stroke-width="3.5"/>
                    <!-- Visor Digital Superior -->
                    <rect x="56" y="22" width="72" height="42" rx="6" fill="#0D0F14" stroke="#000000" stroke-width="2.5"/>
                    <!-- Display 100% Verde -->
                    <text x="92" y="47" fill="#00E676" font-family="monospace" font-weight="bold" font-size="11.5" text-anchor="middle">100%</text>
                    <!-- Portas USB Laranja Fast Charge -->
                    <rect x="69" y="14" width="11" height="3.5" fill="#FF5A1F"/>
                    <rect x="89" y="14" width="11" height="3.5" fill="#FF5A1F"/>
                    <rect x="109" y="14" width="11" height="3.5" fill="#FF5A1F"/>
                    <!-- Especificações Gravadas no Corpo -->
                    <text x="62" y="162" fill="#E2E8F0" font-family="sans-serif" font-weight="bold" font-size="13">22.5W</text>
                    <text x="62" y="172" fill="#94A3B8" font-family="sans-serif" font-weight="bold" font-size="6.5">FAST CHARGE</text>
                    <text x="122" y="168" fill="#CBD5E1" font-family="sans-serif" font-weight="bold" font-size="9" transform="rotate(-90 122 168)">20000mAh</text>
                </g>
            </svg>`;
        }

        // Identidade Oficial ATpromo (Mascote + Logo AT em Laranja e promo em Preto/Branco)
        function getBrandLogoHTML(shadowColor = '#FFD000', sizeClass = 'w-[54px] h-[54px]') {
            if (customLogoImg) {
                return `<img src="${customLogoImg}" alt="ATpromo Logo" class="${sizeClass} object-contain rounded-xl nb-border-thin bg-[#FAF6F0] shrink-0" style="box-shadow: 3px 3px 0px ${shadowColor};" />`;
            }
            return `
            <div class="${sizeClass} rounded-xl bg-[#FAF6F0] nb-border-thin flex flex-col items-center justify-center p-1 relative shrink-0" style="box-shadow: 3px 3px 0px ${shadowColor};">
                <svg viewBox="0 0 80 54" class="w-10 h-7 -mt-0.5">
                    <path d="M25 18 C22 10, 35 6, 40 10 C45 6, 56 10, 52 18 C56 22, 54 28, 50 28 L26 28 C22 26, 22 20, 25 18 Z" fill="#111111"/>
                    <rect x="29" y="14" width="18" height="18" rx="7" fill="#F3C6A5" stroke="#000" stroke-width="2"/>
                    <path d="M33 25 Q38 23 43 25" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="34" cy="20" r="1.5" fill="#000"/>
                    <circle cx="42" cy="20" r="1.5" fill="#000"/>
                    <path d="M22 46 C22 36, 54 36, 54 46" fill="#FFFFFF" stroke="#000" stroke-width="2"/>
                    <polygon points="42,32 66,30 63,46 39,46" fill="#18181B" stroke="#000" stroke-width="2"/>
                    <circle cx="52" cy="38" r="3" fill="#FF5A1F"/>
                </svg>
                <div class="text-[9.5px] font-black tracking-tighter leading-none italic">
                    <span class="text-[#FF5A1F] underline decoration-2">AT</span><span class="text-[#000000]">promo</span>
                </div>
            </div>`;
        }

        function getFormData() {
            const rawCampaign = (document.getElementById('inputCampaign').value || 'BLACK FRIDAY').trim();
            const parts = rawCampaign.split(' ');
            const word1 = parts[0] || 'BLACK';
            const word2 = parts.slice(1).join(' ') || 'FRIDAY';

            return {
                campaignFull: rawCampaign,
                word1: word1,
                word2: word2,
                trigger: document.getElementById('inputTrigger').value || 'Vazou o preço:',
                product: document.getElementById('inputProduct').value || 'ELG Power Bank 20000mAh',
                spec: document.getElementById('inputSpec').value || 'ELG PB200BK • 22,5W',
                store: document.getElementById('inputStore').value || '🛒 AMAZON',
                oldPrice: document.getElementById('inputOldPrice').value || '149,90',
                newPrice: document.getElementById('inputNewPrice').value || '116,75',
                discount: document.getElementById('inputDiscount').value || '22% OFF',
                condition: document.getElementById('inputCondition').value || 'À vista no PIX'
            };
        }

        /* ==========================================================================
           PROPOSTA 1: BLACK FRIDAY PREMIUM
           - Preto profundo (#0A0A0C) com malha arquitetônica dourada sutil
           - Cabeçalho monumental BLACK FRIDAY em Ouro Vibrante (#FFD000) + Preto
           - Vitrine do produto 100% limpa com selo geométrico chanfrado de desconto
           - Bloco comercial de preço em Ouro Vibrante (#FFD000) com sombra dura Branca/Laranja
           ========================================================================== */
        function renderProposal1(d, isSingle) {
            return `
            <div class="flex flex-col items-center">
                <!-- Rótulo do Estúdio -->
                <div class="w-[400px] flex items-center justify-between mb-2 px-1">
                    <div>
                        <span class="text-xs font-black text-[#FFD000] uppercase tracking-wide block">1. BLACK FRIDAY PREMIUM</span>
                        <span class="text-[11px] text-zinc-400">Preto Profundo + Ouro Vibrante (#FFD000) + Contraste Comercial</span>
                    </div>
                    <button onclick="downloadSingleCanvas(0)" class="text-[10px] font-extrabold bg-zinc-800 hover:bg-[#FFD000] hover:text-black text-[#FFD000] px-2.5 py-1 rounded border border-zinc-700 transition">
                        ⬇️ PNG
                    </button>
                </div>

                <!-- 4:5 Instagram Canvas -->
                <div id="canvas-var-0" class="insta-canvas rounded-2xl border-[3.5px] border-zinc-800 bg-grid-premium p-[16px] shadow-2xl ${isSingle ? 'scale-110 my-6' : ''}">
                    
                    <!-- 1. IDENTIFICAÇÃO IMEDIATA: HEADER MONUMENTAL BLACK FRIDAY PREMIUM -->
                    <div class="relative z-10">
                        <div class="flex items-stretch justify-between gap-2 bg-[#FFD000] nb-border rounded-xl p-2 shadow-[4px_4px_0px_#FFFFFF]">
                            <!-- Logo ATpromo -->
                            ${getBrandLogoHTML('#000000', 'w-[50px] h-[50px]')}

                            <!-- Bloco Tipográfico BLACK FRIDAY -->
                            <div class="flex-1 flex flex-col justify-center bg-[#0A0A0C] rounded-lg px-3 py-1 nb-border-thin">
