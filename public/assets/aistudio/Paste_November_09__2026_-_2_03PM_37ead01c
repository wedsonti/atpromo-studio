        // Exportação em Alta Resolução 1080x1350px (Proporção 4:5 Instagram)
        async function downloadSingleCanvas(idx) {
            const targetId = `canvas-var-${idx}`;
            const el = document.getElementById(targetId);
            if (!el || typeof html2canvas === 'undefined') return;

            const btn = document.getElementById('btnDownloadPNG');
            const originalText = btn.innerText;
            btn.innerText = '⏳ Gerando 1080×1350...';

            try {
                const canvas = await html2canvas(el, {
                    scale: 2.7, // 400px * 2.7 = 1080px | 500px * 2.7 = 1350px
                    useCORS: true,
                    backgroundColor: null
                });
                const link = document.createElement('a');
                const names = ['premium', 'explosiva', 'tech'];
                link.download = `ATpromo-BlackFriday-${names[idx]}-1080x1350.png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
            } catch (err) {
                console.error('Erro ao exportar PNG:', err);
            } finally {
                btn.innerText = originalText;
            }
        }

